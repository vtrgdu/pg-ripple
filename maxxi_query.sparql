PREFIX ig:    <https://isagog.com/ontology/top#>
PREFIX maxxi: <https://www.maxxi.art/ontology#>
PREFIX pg:    <http://pg-ripple.org/functions/>

# Prerequisito: embedding della domanda "Opere che raffigurano il Papa,
# pontefice della Chiesa cattolica" salvato con IRI urn:query:papa.
# Deve usare lo stesso modello e dimensioni degli embedding dei passaggi.
# In pg_ripple 0.136.0 pg:similar restituisce una distanza coseno,
# non genera l'embedding della domanda e non seleziona il modello.
# La soglia di similarità 0.65 è indicativa, da calibrare.

SELECT DISTINCT ?opera ?titolo ?artista ?nome
WHERE {
  GRAPH <urn:kb:maxxi> {
    ?opera maxxi:title ?titolo ;
           (ig:authored_by|maxxi:authored_by|^ig:author_of) ?artista .

    ?artista maxxi:nationality ?nazionalita .
    OPTIONAL { ?artista (maxxi:name|ig:anthroponym) ?nome }

    FILTER(
      LCASE(STR(?nazionalita)) IN
      ("italia", "italiana", "italiano", "italy", "italian", "italo-giordana")
    )

    VALUES ?tipo {
      maxxi:CuratorialNote
      maxxi:VisualDescription
    }

    ?passaggio a ?tipo ;
               (ig:about|maxxi:about) ?opera ;
               (ig:text|maxxi:text) ?testo .
  }

  # Similarita >= 0.65 equivale a distanza coseno <= 0.35.
  # In 0.136.0 ABS forza il confronto tra valori numerici SQL e aggira
  # il bug nella gestione del risultato numerico di pg:similar.
  FILTER(pg:similar(?passaggio, "urn:query:papa") <= ABS(0.35))
}
ORDER BY ?nome ?titolo ?opera
